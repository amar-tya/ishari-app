<?xml version="1.0" encoding="utf-8"?>
<!--
  Neutral card background for native ads. Deliberately different from the
  chapter card variants (white / black / lime) so ads are not mistaken for
  app content (AdMob "ads disguised as content" policy).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F3F4F6"/>
    <stroke
        android:width="1dp"
        android:color="#D1D5DB"/>
    <corners android:radius="8dp"/>
</shape>
